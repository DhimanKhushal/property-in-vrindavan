{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "property-in-vrindavan",
  "compatibility_date": "2026-05-16",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "property-in-vrindavan"
    }
  ],
  "routes": [
    {
      "pattern": "propertyinvrindavan.co.in",
      "custom_domain": true
    },
    {
      "pattern": "www.propertyinvrindavan.co.in",
      "custom_domain": true
    },
    {
      "pattern": "flatsinvrindavan.com",
      "custom_domain": true
    },
    {
      "pattern": "www.flatsinvrindavan.com",
      "custom_domain": true
    },
    {
      "pattern": "herohomesvrindavan.in",
      "custom_domain": true
    },
    {
      "pattern": "www.herohomesvrindavan.in",
      "custom_domain": true
    },
    {
      "pattern": "laadigroupvrindavan.com",
      "custom_domain": true
    },
    {
      "pattern": "www.laadigroupvrindavan.com",
      "custom_domain": true
    },
    {
      "pattern": "lodhavrindavan.com",
      "custom_domain": true
    },
    {
      "pattern": "www.lodhavrindavan.com",
      "custom_domain": true
    },
    {
      "pattern": "plotsinvrindavan.co.in",
      "custom_domain": true
    },
    {
      "pattern": "www.plotsinvrindavan.co.in",
      "custom_domain": true
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  }
}
